  "$REVIEW/provider-claim-classification-metadata.tsv" \
  docs/current/STATE.yaml docs/current/ACTIVE_TASK.md docs/current/BRIEF.md STATUS.md
do [ -f "$ROOT/$rel" ] || { echo "libjpeg-gdkpixbuf-review: FAIL: missing $rel" >&2; exit 1; }; done
python3 - "$ROOT" <<'PY'
from pathlib import Path
import csv,sys
root=Path(sys.argv[1]); review=root/'experiments/glibc/selected-obsidian-provider-authority/review'
def read(name):
    with (review/name).open(newline='',encoding='utf-8') as f:return list(csv.DictReader(f,delimiter='\t'))
errors=[]
rows=read('libjpeg-so-62-gdkpixbuf-consumer-binding-result-review.tsv')
if len(rows)!=1: errors.append(f'expected one review row, found {len(rows)}')
row=rows[0] if rows else {}
want={
'review_id':'LIBJPEG-OJ-001-CONSUMER-001','requirement_id':'OJ-001',
'result_archive_sha256':'b010695561974c491aa0706600e867ea3a2b8b8abf43f8573c075418a047d92a',
'repository_head':'43c93d2b9e2cc2879d9b6b24e7b6c7e6eecc33ad','repository_tree':'7a4b22a42216491ea35b71e04643eff34d579ca7',
'candidate_member':'libjpeg.so.62.4.0','candidate_sha256':'a537840ef9da6135cb3284bc3b3e0d1fb4f624180a416c2a3964b94714eb7fe5',
'candidate_soname':'libjpeg.so.62','candidate_rpath_state':'ABSENT','candidate_runpath_state':'ABSENT',
'consumer_member':'libgdk_pixbuf-2.0.so.0.4200.12','consumer_sha256':'16d15168c69d4ad61862462da9fe811b5be3bef898b940a4023e15b039f5b43c',
