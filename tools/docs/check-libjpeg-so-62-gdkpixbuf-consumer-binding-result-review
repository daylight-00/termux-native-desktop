'probe_build_state':'SUCCEEDED','functional_result':'SIGSEGV_BEFORE_OUTPUT','process_exit_code':'139','signal':'SIGSEGV',
'decode_width':'-','decode_height':'-','decode_channels':'-','mapped_candidate_state':'UNPROVEN_DUE_TO_PRE_OUTPUT_SIGSEGV',
'protected_state':'UNCHANGED','candidate_decision':'CANDIDATE_IDENTITY_RETAINED_FUNCTIONAL_VALIDATION_BLOCKED_SIGSEGV',
'provider_authority':'NOT_ACCEPTED'
}
for k,v in want.items():
    if row.get(k)!=v: errors.append(f'{k}: expected {v}, got {row.get(k)!r}')
for field,token in [
('runtime_loader_boundary','TERMUX_GLIBC_LOADER_AND_LIBC_WITH_DEBIAN_GDKPIXBUF_DEPENDENCY_WORLD'),
('diagnostic_conclusion','STATIC_BINDING_SUCCEEDED_FUNCTIONAL_CAUSE_NOT_ISOLATED'),
('remaining_gap','DIRECT_LIBJPEG_CONTROL'),('remaining_gap','ORACLE_VS_CANDIDATE_GDKPIXBUF_CONTROL'),
('next_action','DIAGNOSTIC_MATRIX'),('authority_effect','NO_PROVIDER_COMPOSITION_TARGET_MATERIALIZATION_OR_ACTIVATION_EFFECT'),
('prohibited_inference','DOES_NOT_PROVE_CANDIDATE_ABI_FAILURE')]:
    if token not in row.get(field,''): errors.append(f'{field} lacks {token}')
claims={r['claim_id']:r for r in read('provider-claim-classification.tsv')}
for cid,state,gap in [
('PCC-LIBJPEG-TURBO-ADAPTATION','CLASS_C_PRODUCING_RECORD_ACCEPTED_FIRST_MATRIX_INVALID_LOADER_ISOLATION_REQUIRED','LOADER_ISOLATED_DIRECT_AND_GDKPIXBUF_FUNCTIONAL_EQUIVALENCE'),
('PCC-LIBJPEG-TURBO-PROVIDER','CANDIDATE_IDENTITY_ACCEPTED_FIRST_MATRIX_INVALID_LOADER_ISOLATION_REQUIRED','LOADER_ISOLATED_FUNCTIONAL_EQUIVALENCE'),
('PCC-GLOBAL-BUILD-PROVENANCE','ACTIVE_CLASS_C_PRODUCING_RECORD_ACCEPTED_FIRST_MATRIX_INVALID_LOADER_ISOLATION_REQUIRED','LOADER_ISOLATED_DIRECT_AND_GDKPIXBUF_FUNCTIONAL_EQUIVALENCE')]:
    r=claims.get(cid,{})
    if r.get('classification_state')!=state: errors.append(f'{cid}: state {r.get("classification_state")!r}')
    if gap not in r.get('remaining_gap',''): errors.append(f'{cid}: gap missing {gap}')
meta={r['key']:r['value'] for r in read('provider-claim-classification-metadata.tsv')}
for k,v in {
'oj001_consumer_binding_review_id':'LIBJPEG-OJ-001-CONSUMER-001',
'oj001_consumer_binding_result_sha256':want['result_archive_sha256'],
'oj001_consumer_binding_functional_result':'SIGSEGV_BEFORE_OUTPUT',
'oj001_consumer_binding_static_missing_symbols':'0',
'next_review_tranche':'LIBJPEG_SO_62_GDKPIXBUF_DIRECT_LOADER_ISOLATION_RERUN'}.items():
    if meta.get(k)!=v: errors.append(f'metadata {k}: expected {v}, got {meta.get(k)!r}')
