#!/usr/bin/env bash
set -euo pipefail
ROOT=${1:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}
REVIEW=experiments/glibc/selected-obsidian-provider-authority/review
for rel in \
  docs/evidence/libjpeg-so-62-gdkpixbuf-consumer-binding-result-review.md \
  "$REVIEW/libjpeg-so-62-gdkpixbuf-consumer-binding-result-review.tsv" \
