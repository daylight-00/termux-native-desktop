('active task','Task ID: `rerun-libjpeg-so-62-gdkpixbuf-with-loader-isolation`' in active),
('state result',want['result_archive_sha256'] in state),
('brief SIGSEGV','SIGSEGV' in brief and 'does not yet isolate candidate behavior' in brief),
('status marker','RERUN_LIBJPEG_SO_62_GDKPIXBUF_WITH_LOADER_ISOLATION' in status),
('doc no provider','provider authority: not accepted' in doc),
('doc mixed boundary','loader and core libc came from the Termux-glibc prefix' in doc),
]
for label,ok in checks:
    if not ok: errors.append(f'missing current marker: {label}')
if errors:
    for e in errors: print('libjpeg-gdkpixbuf-review: FAIL:',e,file=sys.stderr)
    raise SystemExit(1)
print('libjpeg-gdkpixbuf-review: PASS: static binding complete; functional SIGSEGV retained as unisolated and provider authority remains open')
