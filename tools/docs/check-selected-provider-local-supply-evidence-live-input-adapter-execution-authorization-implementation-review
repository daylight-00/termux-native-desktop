if fixture.get("fixture_kind") != "SYNTHETIC_REPOSITORY_FIXTURE_ONLY":
    fail("fixture is not synthetic-only")
if len(fixture.get("explicit_input_arguments", [])) != 10:
    fail("fixture explicit input count")
