if len(coordinate_rows) != 41 or any(len(row) != 10 for row in coordinate_rows):
    fail("fixture coordinate cardinality")
if any(not row["absolute_canonical_path"].startswith("/__synthetic__/termux-native-desktop/selected-provider/") for row in coordinate_rows):
    fail("fixture contains non-synthetic coordinate path")
