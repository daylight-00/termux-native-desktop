}
for key, value in expected_meta.items():
    if meta.get(key) != value:
        fail(f"metadata mismatch {key}: {meta.get(key)!r}")
for relative, key in [
    (SOURCE, "implementation_source_sha256"),
    (FIXTURE, "synthetic_fixture_sha256"),
    (NEGATIVES, "synthetic_negative_cases_sha256"),
    (COVERAGE, "implementation_coverage_sha256"),
    (SUCCESS, "synthetic_success_sha256"),
]:
    if meta.get(key) != sha(ROOT / relative):
        fail(f"metadata digest mismatch: {key}")

coverage = rows(ROOT / COVERAGE)
expected_counts = {
    "INPUT": 10,
    "ENVELOPE_FIELD": 20,
    "AUTHORIZATION_CLAIM": 27,
    "VALIDATION": 37,
    "STATE": 18,
    "OPERATION": 32,
    "FAILURE": 20,
}
actual_counts = {kind: sum(row["coverage_kind"] == kind for row in coverage) for kind in expected_counts}
if actual_counts != expected_counts or len(coverage) != 164:
    fail(f"coverage cardinality mismatch: {actual_counts}")
if len({(row["coverage_kind"], row["source_id"]) for row in coverage}) != 164:
    fail("coverage source ids are not unique")
