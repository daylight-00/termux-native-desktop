for forbidden in (
    "import os",
    "import subprocess",
    "import socket",
    "import urllib",
    "import requests",
    "import tarfile",
    "os.open",
    "subprocess.",
    "socket.",
    "rclone",
    "apt ",
    "dpkg",
    ".glob(",
    ".rglob(",
    "os.walk",
    "open(absolute_canonical_path",
    "Path(path).read_bytes",
    "Path(path).open",
):
    if forbidden in source_text:
        fail(f"forbidden implementation surface: {forbidden}")
parsed = ast.parse(source_text)
imports: set[str] = set()
for node in ast.walk(parsed):
    if isinstance(node, ast.Import):
        imports.update(alias.name.split(".")[0] for alias in node.names)
    elif isinstance(node, ast.ImportFrom) and node.module:
        imports.add(node.module.split(".")[0])
if imports & {"os", "subprocess", "socket", "urllib", "requests", "tarfile"}:
    fail(f"forbidden imports: {sorted(imports)}")

module = load_module(ROOT / SOURCE)
success = module.execute_synthetic_case(ROOT, fixture, "success")
expected_success = json.loads((ROOT / SUCCESS).read_text(encoding="utf-8"))
if success != expected_success or success.get("pass") is not True:
    fail("synthetic success drift")
if success.get("coverage_count") != 164 or success.get("operation_count") != 32 or len(success.get("operation_trace", [])) != 32:
    fail("success coverage/operation trace mismatch")
if success.get("state_count") != 18 or len(success.get("state_trace", [])) != 17:
    fail("success state trace mismatch")
if success.get("provider_paths_opened") != [] or success.get("provider_bytes_read") != 0 or success.get("writes_performed") != []:
    fail("success reports provider reads or writes")
if success.get("accepted_synthetic_cli_invoked") is not False or success.get("live_to_synthetic_rewrite_performed") is not False:
    fail("success widens synthetic boundary")
if success.get("synthetic_replay_registry_write_performed") is not False:
    fail("success persists replay tuple")

