#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
required=(
  docs/evidence/selected-obsidian-provider-composition-review.md
  experiments/glibc/selected-obsidian-provider-authority/review/selected-provider-composition-members.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/selected-provider-composition-gaps.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/selected-provider-composition-metadata.tsv
  experiments/glibc/selected-obsidian-provider-authority/recipe/generate-selected-provider-composition-review.py
  experiments/glibc/selected-obsidian-provider-authority/review/provider-claim-classification.tsv
  docs/current/STATE.yaml docs/current/ACTIVE_TASK.md docs/current/BRIEF.md docs/catalog.tsv STATUS.md
)
for rel in "${required[@]}"; do [ -f "$ROOT/$rel" ] || { echo "provider-composition: FAIL: missing $rel" >&2; exit 1; }; done
TMP_BASE=${TND_TEST_TMPDIR:-${TMPDIR:-$ROOT/.tmp}}; mkdir -p "$TMP_BASE"; TMP=$(mktemp -d "$TMP_BASE/provider-composition-check.XXXXXX"); trap 'rm -rf "$TMP"' EXIT
python3 "$ROOT/experiments/glibc/selected-obsidian-provider-authority/recipe/generate-selected-provider-composition-review.py" --repo-root "$ROOT" --output-root "$TMP"
for rel in \
 experiments/glibc/selected-obsidian-provider-authority/review/selected-provider-composition-members.tsv \
 experiments/glibc/selected-obsidian-provider-authority/review/selected-provider-composition-gaps.tsv \
 experiments/glibc/selected-obsidian-provider-authority/review/selected-provider-composition-metadata.tsv; do
 cmp "$ROOT/$rel" "$TMP/$rel" || { echo "provider-composition: FAIL: generated drift $rel" >&2; exit 1; }
done
python3 - "$ROOT" <<'PY'
from pathlib import Path
import csv,sys
root=Path(sys.argv[1]); review=root/'experiments/glibc/selected-obsidian-provider-authority/review'
def read(n):
 with (review/n).open(newline='',encoding='utf-8') as f:return list(csv.DictReader(f,delimiter='\t'))
mem=read('selected-provider-composition-members.tsv'); gaps=read('selected-provider-composition-gaps.tsv'); meta={r['key']:r['value'] for r in read('selected-provider-composition-metadata.tsv')}; claims={r['claim_id']:r for r in read('provider-claim-classification.tsv')}
errors=[]
exp={'selected_gtk_identity_count':'36','accepted_provider_root_count':'8','accepted_member_count':'10','included_member_count':'9','deferred_member_count':'1','unresolved_selected_identity_count':'27','reviewed_root_gap_count':'17','outside_28_root_gap_count':'10','accepted_soname_collision_count':'0','accepted_alias_collision_count':'0','composition_decision':'REVIEWED_BLOCKED_INCOMPLETE','target_manifest_allowed':'NO','next_review_tranche':'GDKPIXBUF_CORE_PROVIDER_TRANCHE','authority_effect':'NO_TARGET_POPULATION_MATERIALIZATION_OR_ACTIVATION'}
for k,v in exp.items():
 if meta.get(k)!=v:errors.append(f'metadata {k}: expected {v}, got {meta.get(k)!r}')
if len(mem)!=10:errors.append(f'member rows {len(mem)}')
if sum(r['composition_inclusion']=='INCLUDED_SELECTED_GTK_SCOPE' for r in mem)!=9:errors.append('included member count mismatch')
if sum(r['composition_inclusion']=='DEFERRED_PROFILE_REQUIREMENT_OPEN' for r in mem)!=1:errors.append('deferred member count mismatch')
if len({r['soname'] for r in mem})!=10:errors.append('SONAME collision')
if len({r['alias_basename'] for r in mem})!=10:errors.append('alias collision')
if any(r['collision_state'].startswith('NO_') is False for r in mem):errors.append('non-clean accepted collision state')
if not any(r['recipe_root']=='gpkg/libtasn1' and r['composition_inclusion']=='DEFERRED_PROFILE_REQUIREMENT_OPEN' for r in mem):errors.append('libtasn1 not deferred')
if not any(r['member_basename']=='libjpeg.so.62.4.0' and r['alias_basename']=='libjpeg.so.62' for r in mem):errors.append('exact libjpeg member/alias missing')
if len(gaps)!=27:errors.append(f'gap rows {len(gaps)}')
if sum(r['priority_tranche']=='GDKPIXBUF_CORE_PROVIDER_TRANCHE' for r in gaps)!=6:errors.append('GdkPixbuf core gap count mismatch')
for name in ['libgdk_pixbuf-2.0.so.0.4200.12','libglib-2.0.so.0.8400.4','libgobject-2.0.so.0.8400.4','libgio-2.0.so.0.8400.4','libgmodule-2.0.so.0.8400.4','libpng16.so.16.48.0']:
 if not any(r['identity_label']==name and r['priority_tranche']=='GDKPIXBUF_CORE_PROVIDER_TRANCHE' for r in gaps):errors.append(f'core gap missing {name}')
claim=claims.get('PCC-GLOBAL-COMPOSITION')
if not claim:errors.append('global composition claim missing')
else:
 if claim['classification_state']!='REVIEWED_BLOCKED_INCOMPLETE':errors.append('composition claim state widened or stale')
 if '27_SELECTED_GTK_PROVIDER_IDENTITIES' not in claim['remaining_gap']:errors.append('composition gap count absent')
 if claim['authority_effect']!='COMPOSITION_REVIEW_COMPLETED_NO_ACCEPTANCE_TARGET_OR_ACTIVATION_EFFECT':errors.append('composition authority effect widened')
state=(root/'docs/current/STATE.yaml').read_text();active=(root/'docs/current/ACTIVE_TASK.md').read_text();brief=(root/'docs/current/BRIEF.md').read_text();catalog=(root/'docs/catalog.tsv').read_text();status=(root/'STATUS.md').read_text();doc=(root/'docs/evidence/selected-obsidian-provider-composition-review.md').read_text()
markers=[('state decision','decision: reviewed-blocked-incomplete' in state),('state gaps','unresolved_selected_identities: 27' in state),('state target false','target_manifest_allowed: false' in state),('task','Task ID: `produce-gdkpixbuf-2-42-12-provider-candidate`' in active),('brief','27 selected identity gaps' in brief),('catalog','selected-obsidian-provider-composition-review\tevidence\tcurrent\tcanonical' in catalog),('status','`REVIEWED_BLOCKED_INCOMPLETE`' in status),('doc decision','REVIEWED_BLOCKED_INCOMPLETE' in doc),('doc target','target manifest allowed:          NO' in doc)]
for label,ok in markers:
 if not ok:errors.append(f'missing current marker: {label}')
for forbidden in ['composition decision:             ACCEPTED','target manifest allowed:          YES']:
 if forbidden in doc:errors.append(f'forbidden widening: {forbidden}')
if errors:
 for e in errors:print('provider-composition: FAIL:',e,file=sys.stderr)
 raise SystemExit(1)
print('provider-composition: PASS: 10 accepted members, 9 included, 1 deferred and 27 selected GTK gaps block composition and target generation')
PY
