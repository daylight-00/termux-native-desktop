#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
REVIEW=experiments/glibc/selected-obsidian-provider-authority/review/gdkpixbuf-2-42-12-provider-candidate-result-review.tsv
required=(
  "$REVIEW"
  docs/evidence/gdkpixbuf-2-42-12-provider-candidate-result-review.md
  docs/operations/EXECUTION.md docs/catalog.tsv
)
for rel in "${required[@]}"; do [ -f "$ROOT/$rel" ] || { echo "gdkpixbuf-provider-review: FAIL: missing $rel" >&2; exit 1; }; done
python3 - "$ROOT" <<'PY'
from pathlib import Path
import csv,sys
root=Path(sys.argv[1])
path=root/'experiments/glibc/selected-obsidian-provider-authority/review/gdkpixbuf-2-42-12-provider-candidate-result-review.tsv'
with path.open(newline='',encoding='utf-8') as f: rows=list(csv.DictReader(f,delimiter='\t'))
errors=[]
if len(rows)!=1: errors.append(f'expected one review row, got {len(rows)}')
else:
 r=rows[0]
 exp={
  'review_id':'GDKPIXBUF-PROV-001','source_version':'2.42.12',
  'source_sha256':'b9505b3445b9a7e48ced34760c3bcb73e966df3ac94c95a148cb669ab748e3c7',
  'result_archive_sha256':'1cebcf8784c6d2e8c8549eadd63007d9f99bb3e90e35ce0786a5d89f6cbecca0',
  'result_repository_head':'de877c9d20fbf2052c563620368aab8af36e332f',
  'result_repository_tree':'8f04a2df382d91be516521929beb92df77ff39f2',
  'candidate_member':'libgdk_pixbuf-2.0.so.0.4200.12',
  'candidate_sha256':'0c1404c6854e7674428a5b653b240759dac0374631697fe61ae275898f6a809f',
  'build_id':'3e9a87bdfc7e017001e570535eb8c09a4e3a8806',
  'observed_soname':'libgdk_pixbuf-2.0.so.0','machine':'AArch64',
  'dt_rpath_state':'ABSENT','dt_runpath_state':'ABSENT',
  'functional_matrix':'JPEG_FILE_PASS;JPEG_MEMORY_PASS;PNG_FILE_PASS;PNG_MEMORY_PASS',
  'exact_map_count':'9','protected_state':'UNCHANGED','result_manifest_state':'PASS',
  'decision':'ACCEPTED_BOUNDED_PROVIDER',
 }
 for k,v in exp.items():
  if r.get(k)!=v: errors.append(f'{k}: expected {v}, got {r.get(k)!r}')
 for token in ['libglib-2.0.so.0','libgobject-2.0.so.0','libgmodule-2.0.so.0','libgio-2.0.so.0','libpng16.so.16','libjpeg.so.62']:
  if token not in r['direct_needed_set']: errors.append(f'missing direct dependency {token}')
 if 'DIAGNOSTIC_ONLY_NO_PROVIDER_AUTHORITY' not in r['transitive_map_state']: errors.append('transitive authority widened')
 if 'GLIB_FAMILY_LIBPNG_PROVIDER_AUTHORITY' not in r['remaining_gap']: errors.append('dependency provider gap missing')
 if 'NO_COMPLETE_COMPOSITION_TARGET_OR_ACTIVATION_EFFECT' not in r['authority_effect']: errors.append('authority effect widened')
doc=(root/'docs/evidence/gdkpixbuf-2-42-12-provider-candidate-result-review.md').read_text(); catalog=(root/'docs/catalog.tsv').read_text(); ops=(root/'docs/operations/EXECUTION.md').read_text()
markers=[
 ('doc decision','ACCEPTED_BOUNDED_PROVIDER' in doc),
 ('catalog','gdkpixbuf-2-42-12-provider-candidate-result-review	evidence	current	canonical' in catalog),
 ('structured TSV rule','A `.tsv` file contains real tab delimiters' in ops),
]
for label,ok in markers:
 if not ok: errors.append(f'missing marker: {label}')
for forbidden in ['complete runtime composition: ACCEPTED','target manifest allowed:          YES','provider authority for GLib, libpng, libmount or libblkid: ACCEPTED']:
 if forbidden in doc: errors.append(f'forbidden widening: {forbidden}')
if errors:
 for e in errors: print('gdkpixbuf-provider-review: FAIL:',e,file=sys.stderr)
 raise SystemExit(1)
print('gdkpixbuf-provider-review: PASS: exact GdkPixbuf provider accepted; reference and transitive dependencies remain open')
PY
