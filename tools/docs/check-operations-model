#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
FAILURES=0
pass() { printf 'operations-model: PASS: %s\n' "$*"; }
fail() { printf 'operations-model: FAIL: %s\n' "$*" >&2; FAILURES=$((FAILURES + 1)); }
require_text() {
  local rel=$1 pattern=$2 label=$3
  grep -Fq -- "$pattern" "$ROOT/$rel" && pass "$label" || fail "$label"
}
reject_text() {
  local rel=$1 pattern=$2 label=$3
  grep -Fq -- "$pattern" "$ROOT/$rel" && fail "$label" || pass "$label"
}

required=(
  docs/operations/README.md
  docs/operations/COLLABORATION.md
  docs/operations/WORKFLOW.md
  docs/operations/EXECUTION.md
  docs/operations/TEST_AUTHORITY.md
  docs/operations/CHECKPOINTS.md
  docs/operations/TROUBLESHOOTING.md
  docs/operations/platforms/chatgpt-web.md
  docs/history/session-operations-v1/README.md
  docs/history/session-operations-v1/CHANGELOG.md
)
for rel in "${required[@]}"; do
  [ -f "$ROOT/$rel" ] && pass "$rel exists" || fail "$rel missing"
done

if [ -e "$ROOT/docs/session-operations" ]; then
  fail 'retired docs/session-operations path still exists'
else
  pass 'retired docs/session-operations path is absent'
fi

require_text docs/operations/README.md 'single current authority' 'operations router declares single current authority'
require_text docs/operations/COLLABORATION.md 'full Git bundle' 'collaboration contract declares full-bundle transport'
require_text docs/operations/COLLABORATION.md 'exactly one raw `.tar.zst`' 'collaboration contract keeps one-package exchange'
require_text docs/operations/WORKFLOW.md 'RECEIVE_FULL_BUNDLE' 'workflow begins from full bundle'
require_text docs/operations/WORKFLOW.md 'there is no handoff action' 'clean accepted workflow has no handoff action'
require_text docs/operations/EXECUTION.md 'never attempt rollback after a confirmed successful push' 'execution contract preserves successful push boundary'
require_text docs/operations/TEST_AUTHORITY.md 'must not pin' 'test authority forbids moving-state coupling'
require_text docs/operations/TEST_AUTHORITY.md 'tests/history/' 'test authority routes superseded stage smokes'
require_text docs/operations/CHECKPOINTS.md 'explicitly non-authoritative' 'checkpoint contract is non-authoritative'
require_text docs/operations/platforms/chatgpt-web.md 'Docker is not available' 'web profile prohibits Docker'
require_text docs/operations/platforms/chatgpt-web.md 'located anywhere under `/mnt/data`' 'web profile records local upload subtree rule'
require_text docs/operations/platforms/chatgpt-web.md 'first upload attempt can block local-path-to-file-reference rewriting even in an existing chat' 'web profile records runtime-first-upload constraint'
require_text docs/operations/platforms/chatgpt-web.md 'not a replacement for the bundle' 'web profile rejects connector-as-clone substitution'
require_text docs/operations/platforms/chatgpt-web.md 'chatgpt-web-limitations.tsv' 'web profile routes limitation registry'
require_text docs/operations/platforms/chatgpt-web-limitations.tsv 'WEB-NET-DNS-001' 'limitation registry records DNS fallback'
require_text AGENTS.md 'network-backed repository clone, pull, and push operations' 'agent contract limits remote Git transport to Termux'
require_text AGENTS.md 'do not try another connector call' 'agent contract forbids same-delivery connector retries'
require_text docs/operations/COLLABORATION.md '`$HOME/Downloads`' 'collaboration contract records default download directory'
require_text docs/operations/COLLABORATION.md 'one user-visible sandbox link and stops' 'collaboration contract defines strict Drive fallback'
require_text docs/operations/COLLABORATION.md 'one wrapper invocation' 'collaboration contract minimizes user commands'
require_text docs/operations/EXECUTION.md 'clone, pull, and push only from the user Termux environment' 'execution contract limits remote Git transport'
require_text docs/operations/platforms/chatgpt-web.md 'first and only connector attempt' 'web profile forbids same-delivery connector retries'
require_text docs/operations/platforms/chatgpt-web.md '`rclone copyto` command that downloads the package to `$HOME/Downloads`' 'web profile records connector-success download command'
require_text docs/operations/platforms/chatgpt-web.md 'sandbox may only materialize the attached bundle locally' 'web profile distinguishes bundle materialization from remote clone'
require_text docs/operations/platforms/chatgpt-web-limitations.tsv 'WEB-REMOTE-GIT-001' 'limitation registry records remote Git authority'
require_text docs/history/session-operations-v1/README.md 'Current operational authority is under' 'former session operations are historical'
require_text docs/handoff/README.md '[`../operations/`](../operations/README.md)' 'handoff archive routes current operations correctly'
require_text docs/current/STATE.yaml 'operations_surface: docs/operations/README.md' 'semantic state records canonical operations surface'

for rel in AGENTS.md docs/operations/README.md docs/operations/COLLABORATION.md docs/operations/WORKFLOW.md docs/operations/EXECUTION.md docs/operations/CHECKPOINTS.md docs/operations/platforms/chatgpt-web.md; do
  reject_text "$rel" 'mandatory handoff' "$rel has no mandatory-handoff authority"
done

for forbidden in \
  'copy the identical bytes to a short ASCII path' \
  'user rclone for the current delivery'
do
  reject_text docs/operations/TROUBLESHOOTING.md "$forbidden" "troubleshooting has no same-delivery alternate upload route: $forbidden"
  reject_text docs/operations/platforms/chatgpt-web.md "$forbidden" "web profile has no same-delivery alternate upload route: $forbidden"
done

python3 - "$ROOT" <<'PY'
from pathlib import Path
import csv, re, sys
root=Path(sys.argv[1])
rows=list(csv.DictReader((root/'docs/catalog.tsv').open(), delimiter='\t'))
by_id={r['document_id']:r for r in rows}
errors=[]
expected={
 'operations-index':('operations','current','canonical','docs/operations/README.md'),
 'operations-collaboration':('operations','current','canonical','docs/operations/COLLABORATION.md'),
 'operations-workflow':('operations','current','canonical','docs/operations/WORKFLOW.md'),
 'operations-execution':('operations','current','canonical','docs/operations/EXECUTION.md'),
 'operations-test-authority':('operations','current','canonical','docs/operations/TEST_AUTHORITY.md'),
 'operations-checkpoints':('operations','current','canonical','docs/operations/CHECKPOINTS.md'),
 'operations-troubleshooting':('operations','current','operational','docs/operations/TROUBLESHOOTING.md'),
 'chatgpt-web-profile':('operations','current','operational','docs/operations/platforms/chatgpt-web.md'),
 'chatgpt-web-limitations':('operations','current','operational','docs/operations/platforms/chatgpt-web-limitations.tsv'),
 'session-operations-history':('history','historical','history','docs/history/session-operations-v1/README.md'),
}
for did, want in expected.items():
    row=by_id.get(did)
    if row is None:
        errors.append(f'missing catalog row {did}')
        continue
    got=(row['class'],row['status'],row['authority'],row['path'])
    if got != want:
        errors.append(f'{did}: expected {want}, got {got}')
for row in rows:
    if row['status'] in {'current','accepted'} and row['path'].startswith('docs/session-operations/'):
        errors.append(f'current catalog row uses retired session-operations path: {row}')

current_files=[
 'AGENTS.md','START_HERE.md','STATUS.md','docs/README.md','docs/INDEX.md',
 'docs/DOCUMENTATION_MODEL.md','docs/current/BRIEF.md','docs/current/STATE.yaml',
 'docs/current/ACTIVE_TASK.md','docs/operations/README.md',
 'docs/operations/COLLABORATION.md','docs/operations/WORKFLOW.md',
 'docs/operations/EXECUTION.md','docs/operations/TEST_AUTHORITY.md','docs/operations/CHECKPOINTS.md',
 'docs/operations/TROUBLESHOOTING.md','docs/operations/platforms/chatgpt-web.md',
]
link_pat=re.compile(r'\[[^\]]*\]\(([^)]*)\)')
for rel in current_files:
    text=(root/rel).read_text(errors='replace')
    for target in link_pat.findall(text):
        clean=target.split('#',1)[0]
        if clean.startswith(('docs/session-operations/','session-operations/','../session-operations/')):
            errors.append(f'{rel}: links to retired session-operations surface: {target}')
if errors:
    for e in errors: print('operations-model: FAIL:',e,file=sys.stderr)
    raise SystemExit(1)
print('operations-model: PASS: catalog and current-link ownership are coherent')
PY
rc=$?
[ "$rc" -eq 0 ] || FAILURES=$((FAILURES + 1))

[ "$FAILURES" -eq 0 ] || exit 1
printf 'operations-model: all checks passed\n'
