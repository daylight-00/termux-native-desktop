#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
TMP_BASE=${TND_TEST_TMPDIR:-${TMPDIR:-$ROOT/.tmp}}
mkdir -p "$TMP_BASE"
TMP=$(mktemp -d "$TMP_BASE/provider-claim-check.XXXXXX")
cleanup() { chmod -R u+w "$TMP" 2>/dev/null || true; rm -rf "$TMP"; }
trap cleanup EXIT HUP INT TERM

required=(
  docs/evidence/provider-claim-classification.md
  experiments/glibc/selected-obsidian-provider-authority/recipe/generate-provider-claim-classification.py
  experiments/glibc/selected-obsidian-provider-authority/review/provider-claim-classification.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/provider-sup-02-request-disposition.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/provider-claim-classification-metadata.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/no-token-recipe-semantic-review.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/xorg-reference-consumed-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/libtasn1-reference-consumed-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/libepoxy-reference-consumed-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/pango-reference-consumed-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/gdkpixbuf-reference-dependency-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/gdkpixbuf-exact-util-linux-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/libxcursor-bounded-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/libthai-libdatrie-bounded-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/libcloudproviders-bounded-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/fribidi-bounded-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/freetype-bounded-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/libxkbcommon-bounded-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/harfbuzz-bounded-provider-authority.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/libjpeg-so-62-provider-candidate-disposition.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/libjpeg-so-62-runpath-free-compatibility-provider-candidate-result-review.tsv
  experiments/glibc/selected-obsidian-provider-authority/review/libjpeg-so-62-loader-isolated-provider-authority.tsv
)
for rel in "${required[@]}"; do
  [ -f "$ROOT/$rel" ] || { echo "provider-claim-classification: FAIL: missing $rel" >&2; exit 1; }
done

if [ "${TND_SKIP_GENERATED_DRIFT:-0}" != 1 ]; then
  python3 "$ROOT/experiments/glibc/selected-obsidian-provider-authority/recipe/generate-provider-claim-classification.py" \
    --repo-root "$ROOT" --output-root "$TMP"
  for rel in \
    experiments/glibc/selected-obsidian-provider-authority/review/provider-claim-classification.tsv \
    experiments/glibc/selected-obsidian-provider-authority/review/provider-sup-02-request-disposition.tsv \
    experiments/glibc/selected-obsidian-provider-authority/review/provider-claim-classification-metadata.tsv
  do
    cmp "$ROOT/$rel" "$TMP/$rel" >/dev/null || {
      echo "provider-claim-classification: FAIL: generated output drift: $rel" >&2
      exit 1
    }
  done
fi

python3 - "$ROOT" <<'PY'
from pathlib import Path
import csv, sys
from collections import Counter, defaultdict

root = Path(sys.argv[1])
review = root / 'experiments/glibc/selected-obsidian-provider-authority/review'

def read(name):
    with (review/name).open(newline='', encoding='utf-8') as fh:
        return list(csv.DictReader(fh, delimiter='\t'))

claims = read('provider-claim-classification.tsv')
dispositions = read('provider-sup-02-request-disposition.tsv')
roots = read('generic-build-attestation-adaptation-root-review-set.tsv')
requests = read('generic-build-attestation-adaptation-gap-evidence-supply-batch-sup-02-custodian-export-requests.tsv')
metadata = {row['key']: row['value'] for row in read('provider-claim-classification-metadata.tsv')}
provider_reviews = read('xorg-reference-consumed-provider-authority.tsv') + read('libtasn1-reference-consumed-provider-authority.tsv') + read('libepoxy-reference-consumed-provider-authority.tsv') + read('pango-reference-consumed-provider-authority.tsv') + read('gdkpixbuf-reference-dependency-provider-authority.tsv') + read('gdkpixbuf-exact-util-linux-provider-authority.tsv') + read('libxcursor-bounded-provider-authority.tsv') + read('libthai-libdatrie-bounded-provider-authority.tsv') + read('libcloudproviders-bounded-provider-authority.tsv') + read('fribidi-bounded-provider-authority.tsv') + read('freetype-bounded-provider-authority.tsv') + read('libxkbcommon-bounded-provider-authority.tsv') + read('harfbuzz-bounded-provider-authority.tsv') + read('libjpeg-so-62-loader-isolated-provider-authority.tsv')
provider_review_by_root = {row['root_review_id']: row for row in provider_reviews}

errors=[]
expected_meta={
    'root_count':'28','object_count':'37','claim_count':'89',
    'artifact_identity_claim_count':'28','adaptation_claim_count':'28',
    'provider_authority_claim_count':'28','object_requirement_claim_count':'1',
    'global_claim_count':'4','class_a_claim_count':'36','class_b_claim_count':'49',
    'class_c_claim_count':'1','class_d_claim_count':'3','sup02_request_count':'28',
    'sup02_still_necessary_count':'0','sup02_narrowed_count':'14',
    'sup02_replaced_count':'7','sup02_unnecessary_count':'7',
    'no_token_semantic_review_count':'7','no_token_confirmed_a_count':'7',
    'no_token_reclassified_b_count':'0','provider_review_count':'19',
    'provider_authority_accepted_count':'19','provider_authority_open_count':'9',
    'authority_effect':'NINETEEN_BOUNDED_PROVIDER_CLAIMS_ACCEPTED_NO_COMPOSITION_TARGET_OR_ACTIVATION_EFFECT',
    'oj001_disposition':'RUNPATH_FREE_COMPATIBILITY_PROVIDER_ACCEPTED_BOUNDED_GDKPIXBUF_JPEG_SCOPE',
    'oj001_required_identity':'libjpeg.so.62',
    'oj001_candidate_state':'NO_EXACT_REPOSITORY_SONAME_62_ARTIFACT;PROJECT_RUNPATH_FREE_V6B_CANDIDATE_BOUNDED_PROVIDER_AUTHORITY_ACCEPTED',
    'oj001_first_candidate_decision':'REJECTED_REBUILD_REQUIRED_NO_RUNPATH',
    'oj001_first_candidate_sha256':'1d32a4b12ef3a6032626af13b69a64c45a0a0a9bb4090e0b61d9312811208d88',
    'oj001_first_candidate_runpath_state':'PRESENT_COLON_ONLY_BUILD_TREE_PLACEHOLDER',
    'oj001_corrected_candidate_decision':'CANDIDATE_IDENTITY_ACCEPTED_PROVIDER_REVIEW_REQUIRED',
    'oj001_corrected_candidate_sha256':'a537840ef9da6135cb3284bc3b3e0d1fb4f624180a416c2a3964b94714eb7fe5',
    'oj001_corrected_candidate_rpath_state':'ABSENT',
    'oj001_corrected_candidate_runpath_state':'ABSENT',
    'oj001_consumer_binding_review_id':'LIBJPEG-OJ-001-CONSUMER-001',
    'oj001_consumer_binding_result_sha256':'b010695561974c491aa0706600e867ea3a2b8b8abf43f8573c075418a047d92a',
    'oj001_consumer_binding_functional_result':'SIGSEGV_BEFORE_OUTPUT',
    'oj001_consumer_binding_static_missing_symbols':'0',
    'oj001_diagnostic_matrix_review_id':'LIBJPEG-OJ-001-DIAGNOSTIC-001',
    'oj001_diagnostic_matrix_result_sha256':'29bedb2494b54602e0768cfb27695acb58e55359f115422cfe5777d4917aaae0',
    'oj001_diagnostic_matrix_classification':'DIRECT_CONTROL_ENVIRONMENT_UNRESOLVED',
    'oj001_diagnostic_matrix_pass_count':'0',
    'oj001_provider_review_id':'LIBJPEG-PROV-001',
    'oj001_provider_result_sha256':'4e546ac1ef2a92f3301dd51ca2328d6901a05e309da78b6d08b26211d9b621e3',
    'oj001_provider_matrix_pass_count':'6',
    'oj001_provider_decision':'ACCEPTED_BOUNDED_PROVIDER',
    'next_review_tranche':'FONTCONFIG_BOUNDED_PROVIDER_AUTHORITY',
}
for key,val in expected_meta.items():
    if metadata.get(key)!=val:
        errors.append(f'metadata {key}: expected {val}, got {metadata.get(key)!r}')

ids=[row['claim_id'] for row in claims]
if len(ids)!=len(set(ids)):
    errors.append('claim_id values are not unique')
if len(claims)!=89:
    errors.append(f'expected 89 claims, found {len(claims)}')

allowed_types={'ARTIFACT_IDENTITY','ADAPTATION_SEMANTICS','PROVIDER_AUTHORITY','OBJECT_REQUIREMENT_IDENTITY','BUILD_PROVENANCE','COMPOSITION','TARGET_POPULATION','ACTIVATION'}
allowed_classes={'A','B','C','D'}
for row in claims:
    if row['claim_type'] not in allowed_types:
        errors.append(f"{row['claim_id']}: invalid claim_type {row['claim_type']}")
    if row['adr_class'] not in allowed_classes:
        errors.append(f"{row['claim_id']}: invalid adr_class {row['adr_class']}")
    for field in ['project_owned_changed_boundary','remaining_gap','minimum_closure_action','authority_effect','prohibited_inference']:
        if not row[field]: errors.append(f"{row['claim_id']}: empty {field}")
    if 'ACCEPTED' in row['authority_effect']:
        provider_ok=(row['claim_type']=='PROVIDER_AUTHORITY' and row['subject_id'] in provider_review_by_root and row['classification_state']=='BOUNDED_PROVIDER_AUTHORITY_ACCEPTED')
        adaptation_ok=(row['claim_type']=='ADAPTATION_SEMANTICS' and row['subject_id'] in provider_review_by_root and row['authority_effect']=='ADAPTATION_CLASSIFICATION_ACCEPTED_NO_COMPOSITION_TARGET_OR_ACTIVATION_EFFECT' and row['claim_id'] in {'PCC-GLIB-ADAPTATION','PCC-LIBPNG-ADAPTATION','PCC-UTIL-LINUX-ADAPTATION','PCC-LIBXCURSOR-ADAPTATION','PCC-LIBTHAI-ADAPTATION','PCC-LIBDATRIE-ADAPTATION','PCC-LIBCLOUDPROVIDERS-ADAPTATION','PCC-FRIBIDI-ADAPTATION','PCC-FREETYPE-ADAPTATION','PCC-LIBXKBCOMMON-ADAPTATION','PCC-HARFBUZZ-ADAPTATION'})
        if not (provider_ok or adaptation_ok):
            errors.append(f"{row['claim_id']}: unreviewed claim has authority effect")
    if row['authority_effect'] in {'PROVIDER_AUTHORITY','TARGET_POPULATION','ACTIVATION'}:
        errors.append(f"{row['claim_id']}: invalid broad authority effect")

by_subject=defaultdict(dict)
for row in claims:
    if row['subject_kind']=='ROOT':
        by_subject[row['subject_id']][row['claim_type']]=row
root_by_id={r['root_review_id']:r for r in roots}
if set(by_subject)!=set(root_by_id):
    errors.append('root claim subjects do not exactly match 28 canonical roots')
for rid, source in root_by_id.items():
    group=by_subject.get(rid,{})
    if set(group)!={'ARTIFACT_IDENTITY','ADAPTATION_SEMANTICS','PROVIDER_AUTHORITY'}:
        errors.append(f'{rid}: expected exactly three separated root claims')
        continue
    if group['ARTIFACT_IDENTITY']['adr_class']!='A':
        errors.append(f'{rid}: artifact identity is not class A')
    expected_adapt='A' if source['adaptation_evidence_tokens']=='NONE_DECLARED' else 'B'
    if group['ADAPTATION_SEMANTICS']['adr_class']!=expected_adapt:
        errors.append(f'{rid}: adaptation class mismatch')
    if group['PROVIDER_AUTHORITY']['adr_class']!='B':
        errors.append(f'{rid}: provider authority is not class B')
    provider_claim=group['PROVIDER_AUTHORITY']
    if rid in provider_review_by_root:
        if provider_claim['classification_state']!='BOUNDED_PROVIDER_AUTHORITY_ACCEPTED':
            errors.append(f'{rid}: reviewed provider claim is not accepted')
        if not provider_claim['remaining_gap'].startswith('NONE_FOR_BOUNDED'):
            errors.append(f'{rid}: reviewed provider gap is not closed')
    elif provider_claim['classification_state']!='CLASSIFIED_OPEN_PROVIDER_AUTHORITY_NOT_ACCEPTED':
        errors.append(f'{rid}: unreviewed provider claim is not open')

ctype=Counter(r['claim_type'] for r in claims)
want_types={'ARTIFACT_IDENTITY':28,'ADAPTATION_SEMANTICS':28,'PROVIDER_AUTHORITY':28,'OBJECT_REQUIREMENT_IDENTITY':1,'BUILD_PROVENANCE':1,'COMPOSITION':1,'TARGET_POPULATION':1,'ACTIVATION':1}
if ctype!=Counter(want_types):
    errors.append(f'claim type counts differ: {dict(ctype)}')
classes=Counter(r['adr_class'] for r in claims)
if classes!=Counter({'A':36,'B':49,'C':1,'D':3}):
    errors.append(f'class counts differ: {dict(classes)}')

request_ids={r['request_id'] for r in requests}
disposition_ids=[r['request_id'] for r in dispositions]
if len(disposition_ids)!=len(set(disposition_ids)):
    errors.append('SUP-02 request disposition IDs are not unique')
if set(disposition_ids)!=request_ids:
    errors.append('SUP-02 dispositions do not exactly cover canonical requests')
counts=Counter(r['disposition'] for r in dispositions)
if counts!=Counter({'NARROWED':14,'REPLACED':7,'UNNECESSARY':7}):
    errors.append(f'SUP-02 disposition counts differ: {dict(counts)}')
for row in dispositions:
    if row['required_now']!='NO':
        errors.append(f"{row['request_id']}: required_now must remain NO")
    if row['disposition']=='STILL_NECESSARY':
        errors.append(f"{row['request_id']}: blanket still-necessary disposition reintroduced")
    if row['authority_effect']!='REQUEST_RECLASSIFICATION_ONLY_NO_EVIDENCE_OR_AUTHORITY_EFFECT':
        errors.append(f"{row['request_id']}: unexpected authority effect")

state=(root/'docs/current/STATE.yaml').read_text()
active=(root/'docs/current/ACTIVE_TASK.md').read_text()
brief=(root/'docs/current/BRIEF.md').read_text()
catalog=(root/'docs/catalog.tsv').read_text()
status=(root/'STATUS.md').read_text()
checks=[
    ('state version','state_version:' in state),
    ('claim count state','total: 89' in state),
    ('SUP-02 state','required_now: 0' in state),
    ('next task','Task ID: `review-fontconfig-bounded-provider-authority`' in active),
    ('brief classification','89 separated claims' in brief),
    ('catalog row','provider-claim-classification\tevidence\tcurrent\tcanonical' in catalog),
    ('status next phase','Fontconfig review active' in status),
    ('disposition catalog','libjpeg-so-62-provider-candidate-disposition\tevidence\tcurrent\tcanonical' in catalog),
]
for label,ok in checks:
    if not ok: errors.append(f'missing current-state marker: {label}')

if errors:
    for err in errors:
        print('provider-claim-classification: FAIL:',err,file=sys.stderr)
    raise SystemExit(1)
print('provider-claim-classification: PASS: 89 claims, 19 bounded inventory providers including HarfBuzz, and 28 SUP-02 dispositions are coherent')
PY

echo 'provider-claim-classification: all checks passed'
