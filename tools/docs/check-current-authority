#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
FAILURES=0

fail() {
  printf 'current-authority: FAIL: %s\n' "$*" >&2
  FAILURES=$((FAILURES + 1))
}

pass() {
  printf 'current-authority: PASS: %s\n' "$*"
}

require_text() {
  local rel=$1 pattern=$2 label=$3
  if grep -Fq -- "$pattern" "$ROOT/$rel"; then
    pass "$label"
  else
    fail "$label"
  fi
}

reject_text() {
  local rel=$1 pattern=$2 label=$3
  if grep -Fq -- "$pattern" "$ROOT/$rel"; then
    fail "$label"
  else
    pass "$label"
  fi
}

require_text STATUS.md 'bundle-native documentation and operations control planes active' 'STATUS declares the documentation and operations control planes'
require_text STATUS.md '89 separated claims' 'STATUS preserves the bounded claim-classification result'
require_text STATUS.md 'exact Cairo and Cairo-GObject accepted atomically; selected-provider composition incomplete with 8 gaps; libXdamage evidence acquisition active' 'STATUS names accepted Cairo authority and libXdamage acquisition'
require_text docs/architecture.md 'immutable releases' 'architecture describes immutable deployment'
require_text docs/architecture.md 'Repository deployment rollback and provider rollback are separate authority domains.' 'architecture separates rollback authorities'
require_text docs/glibc-layer.md 'Repository deployment already uses immutable materialized releases and explicit activation.' 'glibc guide describes explicit activation'
require_text packages/mesa-glibc/README.md 'providers/mesa/current' 'Mesa package documents canonical provider current pointer'
require_text modules/gl/README.md 'compatibility paths into the Mesa workspace' 'gl module classifies legacy build paths as compatibility only'
require_text docs/refactor/README.md 'canonical integration branch:' 'refactor index names the canonical branch field'
require_text docs/refactor/README.md '0165 SUP-02 response producer implementation' 'refactor index covers the accepted chain through 0165'
require_text docs/handoff/CURRENT.md 'Historical tombstone' 'old current handoff is a tombstone'
require_text docs/decisions/0002-glibc-core-from-termux-glibc-repo.md 'Superseded as a universal ownership and sourcing rule.' 'Decision 0002 is explicitly superseded'
require_text docs/decisions/0005-proportional-assurance-depth.md '- **Status:** accepted' 'Decision 0005 is explicitly accepted'
require_text docs/DOCUMENTATION_MODEL.md 'maximum default-onboarding files: 4' 'documentation model bounds default onboarding'
require_text docs/history/README.md 'History is excluded from default onboarding.' 'history router excludes default onboarding'
require_text docs/operations/WORKFLOW.md 'RECEIVE_FULL_BUNDLE' 'operations workflow begins from a full bundle'
require_text docs/operations/CHECKPOINTS.md 'Normal accepted work requires no narrative handoff' 'checkpoint contract removes mandatory handoff creation'
require_text docs/evidence/provider-claim-classification.md 'STILL_NECESSARY: 0' 'provider classification removes blanket mandatory SUP-02 execution'
require_text docs/current/ACTIVE_TASK.md 'Task ID: `acquire-libxdamage-provider-evidence`' 'current task is exact libXdamage evidence acquisition'

reject_text docs/architecture.md 'Current deployment uses source-linked leaves.' 'architecture has no stale source-linked current deployment claim'
reject_text docs/glibc-layer.md 'Current deployed leaves are source-linked symlinks.' 'glibc guide has no stale source-linked current deployment claim'
reject_text docs/gpu.md 'builds into versioned prefixes under `~/gl/opt/`' 'GPU guide has no stale canonical Mesa output path'
reject_text docs/refactor/README.md 'active architecture branch:' 'refactor index has no deleted active-branch field'
reject_text docs/refactor/README.md 'docs/post-graphics-architecture-audit' 'refactor current index has no deleted branch value'
reject_text docs/operations/README.md 'mandatory handoff' 'operations index has no mandatory handoff dependency'
reject_text docs/operations/WORKFLOW.md 'mandatory handoff' 'operations workflow has no mandatory handoff dependency'
reject_text docs/operations/CHECKPOINTS.md 'mandatory handoff' 'checkpoint contract has no mandatory handoff dependency'
reject_text docs/operations/WORKFLOW.md 'handoff/CURRENT.md' 'operations workflow has no CURRENT handoff dependency'
reject_text docs/handoff/CURRENT.md 'branch:' 'handoff tombstone has no stale branch coordinate'
reject_text docs/handoff/CURRENT.md 'HEAD:' 'handoff tombstone has no stale HEAD coordinate'
reject_text docs/system-foundation/REFERENCES.md '../../setup/glibc/' 'foundation references have no removed setup/glibc links'
reject_text docs/system-foundation/REFERENCES.md '../../scripts/deploy-gl.sh' 'foundation references have no removed deploy script link'

"$ROOT/tools/docs/check-fontconfig-bounded-provider-authority"
"$ROOT/tools/docs/check-pixman-cairo-prerequisite-provider-authority"
"$ROOT/tools/docs/check-cairo-bounded-provider-authority"

STATE_VERSION=$(awk '$1 == "state_version:" { print $2; exit }' "$ROOT/docs/current/STATE.yaml")
PENDING_VERSION=$(awk '$1 == "state_version:" { print $2; exit }' "$ROOT/docs/current/PENDING_ARTIFACTS.yaml")
BRIEF_VERSION=$(sed -n 's/^> Semantic state version: `\([^`]*\)`$/\1/p' "$ROOT/docs/current/BRIEF.md" | head -n1)

if [ -n "$STATE_VERSION" ] && [ "$STATE_VERSION" = "$PENDING_VERSION" ] && [ "$STATE_VERSION" = "$BRIEF_VERSION" ]; then
  pass "current state versions agree: $STATE_VERSION"
else
  fail "state version mismatch: state=${STATE_VERSION:-empty} pending=${PENDING_VERSION:-empty} brief=${BRIEF_VERSION:-empty}"
fi

python3 - "$ROOT" <<'PY'
from pathlib import Path
import re
import sys

root = Path(sys.argv[1])
files = [
    'README.md', 'STATUS.md', 'START_HERE.md', 'AGENTS.md', 'CLAUDE.md',
    'docs/README.md', 'docs/INDEX.md', 'docs/DOCUMENTATION_MODEL.md',
    'docs/constitution/README.md', 'docs/constitution/PROJECT.md',
    'docs/constitution/PRINCIPLES.md', 'docs/architecture/README.md',
    'docs/operations/README.md', 'docs/evidence/README.md',
    'docs/history/README.md',
    'docs/current/BRIEF.md', 'docs/current/ACTIVE_TASK.md',
    'docs/architecture.md', 'docs/glibc-layer.md', 'docs/gpu.md',
    'modules/gl/README.md', 'docs/refactor/README.md',
    'docs/operations/COLLABORATION.md',
    'docs/operations/WORKFLOW.md',
    'docs/operations/EXECUTION.md',
    'docs/operations/CHECKPOINTS.md',
    'docs/operations/TROUBLESHOOTING.md',
    'docs/operations/platforms/chatgpt-web.md',
    'docs/handoff/README.md', 'docs/handoff/CURRENT.md',
    'docs/decisions/README.md',
    'docs/decisions/0002-glibc-core-from-termux-glibc-repo.md',
    'docs/decisions/0004-single-main-and-immutable-release-deployment.md',
    'docs/system-foundation/REFERENCES.md',
]
pattern = re.compile(r'\[[^\]]*\]\(([^)]+)\)')
errors = []
for rel in files:
    path = root / rel
    if not path.is_file():
        errors.append(f'{rel}: missing file')
        continue
    text = path.read_text(errors='replace')
    for target in pattern.findall(text):
        target = target.strip()
        if not target or target.startswith(('#', 'http://', 'https://', 'mailto:')):
            continue
        target = target.split('#', 1)[0]
        if not target:
            continue
        resolved = (path.parent / target).resolve()
        try:
            resolved.relative_to(root.resolve())
        except ValueError:
            errors.append(f'{rel}: link escapes repository: {target}')
            continue
        if not resolved.exists():
            errors.append(f'{rel}: missing link target: {target}')
if errors:
    for error in errors:
        print(f'current-authority: FAIL: {error}', file=sys.stderr)
    raise SystemExit(1)
print('current-authority: PASS: selected current-document links resolve')
PY
link_rc=$?
if [ "$link_rc" -ne 0 ]; then
  FAILURES=$((FAILURES + 1))
fi

[ "$FAILURES" -eq 0 ] || exit 1
printf 'current-authority: all checks passed\n'
