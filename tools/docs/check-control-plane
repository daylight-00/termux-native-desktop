#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
FAILURES=0

fail() {
  printf 'control-plane: FAIL: %s\n' "$*" >&2
  FAILURES=$((FAILURES + 1))
}

pass() {
  printf 'control-plane: PASS: %s\n' "$*"
}

require_file() {
  local rel=$1
  if [ -f "$ROOT/$rel" ]; then
    pass "$rel exists"
  else
    fail "$rel is missing"
  fi
}

required_files=(
  START_HERE.md
  AGENTS.md
  CLAUDE.md
  docs/INDEX.md
  docs/DOCUMENTATION_MODEL.md
  docs/catalog.tsv
  docs/constitution/README.md
  docs/constitution/PROJECT.md
  docs/constitution/PRINCIPLES.md
  docs/architecture/README.md
  docs/operations/README.md
  docs/evidence/README.md
  docs/history/README.md
  docs/current/BRIEF.md
  docs/current/STATE.yaml
  docs/current/ACTIVE_TASK.md
  docs/current/PENDING_ARTIFACTS.yaml
  docs/operations/platforms/chatgpt-web.md
)

for rel in "${required_files[@]}"; do
  require_file "$rel"
done

[ "$FAILURES" -eq 0 ] || exit 1

grep -Fq 'AGENTS.md' "$ROOT/CLAUDE.md" \
  && pass 'CLAUDE.md routes to AGENTS.md' \
  || fail 'CLAUDE.md does not route to AGENTS.md'

grep -Fq 'docs/current/BRIEF.md' "$ROOT/START_HERE.md" \
  && grep -Fq 'docs/current/ACTIVE_TASK.md' "$ROOT/START_HERE.md" \
  && pass 'START_HERE.md routes through current state' \
  || fail 'START_HERE.md current-state route is incomplete'

grep -Fq 'user-provided-full-git-bundle' "$ROOT/docs/current/STATE.yaml" \
  && pass 'STATE.yaml declares full-bundle web transport' \
  || fail 'STATE.yaml does not declare full-bundle web transport'

grep -Fq 'lightweight-remote-inspection-only' "$ROOT/docs/current/STATE.yaml" \
  && pass 'STATE.yaml limits the GitHub connector' \
  || fail 'STATE.yaml does not limit the GitHub connector'

ACTIVE_TASK_ID=$(awk '
  /^active_task:/ { in_task=1; next }
  in_task && /^[^[:space:]]/ { in_task=0 }
  in_task && $1 == "id:" { print $2; exit }
' "$ROOT/docs/current/STATE.yaml")

ACTIVE_TASK_DOC=$(awk '
  /^active_task:/ { in_task=1; next }
  in_task && /^[^[:space:]]/ { in_task=0 }
  in_task && $1 == "document:" { print $2; exit }
' "$ROOT/docs/current/STATE.yaml")

[ -n "$ACTIVE_TASK_ID" ] \
  && pass "active task id is $ACTIVE_TASK_ID" \
  || fail 'STATE.yaml active task id is empty'

[ "$ACTIVE_TASK_DOC" = 'docs/current/ACTIVE_TASK.md' ] \
  && pass 'STATE.yaml active task document is canonical' \
  || fail "unexpected active task document: ${ACTIVE_TASK_DOC:-<empty>}"

grep -Fq "Task ID: \`$ACTIVE_TASK_ID\`" "$ROOT/docs/current/ACTIVE_TASK.md" \
  && pass 'ACTIVE_TASK.md id matches STATE.yaml' \
  || fail 'ACTIVE_TASK.md id does not match STATE.yaml'

for heading in \
  '## Objective' \
  '## Why now' \
  '## In scope' \
  '## Out of scope' \
  '## Required reading' \
  '## Pending external inputs' \
  '## Next valid action' \
  '## Stop conditions' \
  '## Completion criteria'
do
  grep -Fqx "$heading" "$ROOT/docs/current/ACTIVE_TASK.md" \
    && pass "ACTIVE_TASK.md contains $heading" \
    || fail "ACTIVE_TASK.md lacks $heading"
done

while IFS= read -r rel; do
  [ -n "$rel" ] || continue
  [ -e "$ROOT/$rel" ] \
    && pass "required-reading target exists: $rel" \
    || fail "required-reading target is missing: $rel"
done < <(
  awk '
    /^## Required reading$/ { in_required=1; next }
    in_required && /^## / { exit }
    in_required { print }
  ' "$ROOT/docs/current/ACTIVE_TASK.md" \
    | sed -n 's/^- `\([^`]*\)`$/\1/p'
)

for rel in START_HERE.md AGENTS.md docs/current/BRIEF.md docs/INDEX.md docs/operations/platforms/chatgpt-web.md; do
  if grep -Fq 'docs/post-graphics-architecture-audit' "$ROOT/$rel"; then
    fail "$rel contains the deleted topic branch"
  else
    pass "$rel does not contain the deleted topic branch"
  fi
done

if grep -Eq 'docs/handoff/CURRENT\.md|handoff/CURRENT\.md' \
    "$ROOT/START_HERE.md" "$ROOT/AGENTS.md" "$ROOT/docs/current/BRIEF.md"; then
  fail 'default onboarding depends on handoff/CURRENT.md'
else
  pass 'default onboarding has no handoff/CURRENT.md dependency'
fi

if grep -Eqi '(^|[^[:alnum:]_-])docker([^[:alnum:]_-]|$)' \
    "$ROOT/docs/current/ACTIVE_TASK.md" "$ROOT/AGENTS.md" "$ROOT/docs/operations/platforms/chatgpt-web.md"; then
  if grep -Fq 'Do not use or propose Docker' "$ROOT/AGENTS.md" \
      && grep -Fq 'Docker is not available' "$ROOT/docs/operations/platforms/chatgpt-web.md"; then
    pass 'Docker references are explicit prohibitions'
  else
    fail 'Docker is mentioned without the required prohibition'
  fi
fi

[ "$FAILURES" -eq 0 ] || exit 1
printf 'control-plane: all checks passed\n'
