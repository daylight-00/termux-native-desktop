#!/usr/bin/env bash
set -euo pipefail
ROOT=${1:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}
REVIEW=experiments/glibc/selected-obsidian-provider-authority/review
for rel in \
  docs/evidence/libjpeg-so-62-provider-candidate-disposition.md \
  docs/evidence/libjpeg-so-62-compatibility-provider-candidate-result-review.md \
  docs/evidence/libjpeg-so-62-runpath-free-compatibility-provider-candidate-result-review.md \
  "$REVIEW/libjpeg-so-62-provider-candidate-disposition.tsv" \
  "$REVIEW/libjpeg-so-62-compatibility-provider-candidate-result-review.tsv" \
  "$REVIEW/libjpeg-so-62-runpath-free-compatibility-provider-candidate-result-review.tsv" \
  "$REVIEW/provider-claim-classification.tsv" \
  "$REVIEW/provider-claim-classification-metadata.tsv"
do [ -f "$ROOT/$rel" ] || { echo "libjpeg-so-62-disposition: FAIL: missing $rel" >&2; exit 1; }; done
python3 - "$ROOT" <<'PY'
from pathlib import Path
import csv,sys
root=Path(sys.argv[1]); review=root/'experiments/glibc/selected-obsidian-provider-authority/review'
def read(n):
    with (review/n).open(newline='',encoding='utf-8') as f:return list(csv.DictReader(f,delimiter='\t'))
errors=[]
row=read('libjpeg-so-62-provider-candidate-disposition.tsv')[0]
want={
'review_id':'LIBJPEG-OJ-001-DISP-001','requirement_id':'OJ-001','required_lookup_identity':'libjpeg.so.62',
'prior_oracle_concrete_identity':'libjpeg.so.62.3.0','rejected_artifact_package':'libjpeg-turbo-glibc',
'rejected_artifact_sha256':'e672a721d7a949048cab5c7073ef0a0c05f627b8fc691ecc2d0adea6a5a5689e',
'upstream_source_sha256':'9564c72b1dfd1d6fe6274c5f95a8d989b59854575d4bbee44ade7bc17aa9bc93',
'expected_compatibility_soname':'libjpeg.so.62','expected_compatibility_concrete_member':'libjpeg.so.62.4.0',
'disposition':'RUNPATH_FREE_COMPATIBILITY_PROVIDER_CANDIDATE_IDENTITY_ACCEPTED_PROVIDER_REVIEW_REQUIRED',
'authority_effect':'CANDIDATE_IDENTITY_ONLY_NO_PROVIDER_COMPOSITION_TARGET_MATERIALIZATION_OR_ACTIVATION_EFFECT',
}
for k,v in want.items():
    if row.get(k)!=v: errors.append(f'{k}: expected {v}, got {row.get(k)!r}')
for field,token in [
('exact_repository_candidate_state','RUNPATH_FREE_PROJECT_CANDIDATE_IDENTITY_ACCEPTED'),
('required_build_delta','CMAKE_SKIP_RPATH_ON'),('required_build_delta','NO_DT_RPATH_OR_DT_RUNPATH'),
('next_action','GDK_PIXBUF_CONSUMER_BINDING'),('prohibited_inference','LIBJPEG_SO_8_AS_SUBSTITUTE'),
('prohibited_inference','ACCEPT_PROVIDER_AUTHORITY')]:
    if token not in row.get(field,''): errors.append(f'{field} lacks {token}')
first=read('libjpeg-so-62-compatibility-provider-candidate-result-review.tsv')[0]
second=read('libjpeg-so-62-runpath-free-compatibility-provider-candidate-result-review.tsv')[0]
if first['candidate_decision']!='REJECTED_REBUILD_REQUIRED_NO_RUNPATH': errors.append('first candidate rejection lost')
second_want={
'candidate_sha256':'a537840ef9da6135cb3284bc3b3e0d1fb4f624180a416c2a3964b94714eb7fe5',
'dt_soname':'libjpeg.so.62','dt_rpath_state':'ABSENT','dt_runpath_state':'ABSENT',
'candidate_decision':'CANDIDATE_IDENTITY_ACCEPTED_PROVIDER_REVIEW_REQUIRED',
'provider_authority':'NOT_ACCEPTED' if 'provider_authority' in second else None,
}
for k,v in list(second_want.items()):
    if v is not None and second.get(k)!=v: errors.append(f'corrected {k}: expected {v}, got {second.get(k)!r}')
claims={r['claim_id']:r for r in read('provider-claim-classification.tsv')}
want_claims={
'PCC-LIBJPEG-TURBO-ARTIFACT':('RUNPATH_FREE_COMPATIBILITY_CANDIDATE_IDENTITY_ACCEPTED','NONE_FOR_RUNPATH_FREE_EXACT_COMPATIBILITY_CANDIDATE_IDENTITY'),
'PCC-LIBJPEG-TURBO-PROVIDER':('RUNPATH_FREE_CANDIDATE_IDENTITY_ACCEPTED_PROVIDER_REVIEW_REQUIRED','BOUNDED_CONSUMER_BINDING_FUNCTIONAL_EQUIVALENCE'),
'PCC-OJ-001-REQUIRED-OBJECT':('RUNPATH_FREE_EXACT_CANDIDATE_IDENTITY_ACCEPTED','NONE_FOR_REQUIRED_SONAME_AND_EXACT_RUNPATH_FREE_CANDIDATE_IDENTITY'),
'PCC-GLOBAL-BUILD-PROVENANCE':('ACTIVE_CLASS_C_PRODUCING_RECORD_ACCEPTED_FUNCTIONAL_EQUIVALENCE_OPEN','BOUNDED_FUNCTIONAL_EQUIVALENCE_AND_EXACT_CONSUMER_BINDING'),
}
for cid,(state,gap) in want_claims.items():
    r=claims.get(cid,{})
    if r.get('classification_state')!=state: errors.append(f'{cid}: state {r.get("classification_state")!r}')
    if gap not in r.get('remaining_gap',''): errors.append(f'{cid}: gap missing {gap}')
meta={r['key']:r['value'] for r in read('provider-claim-classification-metadata.tsv')}
meta_want={
'oj001_disposition':want['disposition'],'oj001_corrected_candidate_decision':'CANDIDATE_IDENTITY_ACCEPTED_PROVIDER_REVIEW_REQUIRED',
'oj001_corrected_candidate_sha256':'a537840ef9da6135cb3284bc3b3e0d1fb4f624180a416c2a3964b94714eb7fe5',
'oj001_corrected_candidate_rpath_state':'ABSENT','oj001_corrected_candidate_runpath_state':'ABSENT',
'next_review_tranche':'LIBJPEG_SO_62_BOUNDED_GDK_PIXBUF_CONSUMER_BINDING_VALIDATION'}
for k,v in meta_want.items():
    if meta.get(k)!=v: errors.append(f'metadata {k}: expected {v}, got {meta.get(k)!r}')
state=(root/'docs/current/STATE.yaml').read_text(); active=(root/'docs/current/ACTIVE_TASK.md').read_text(); brief=(root/'docs/current/BRIEF.md').read_text(); status=(root/'STATUS.md').read_text()
for label,ok in [
('state version','state_version: 2026-07-15.16' in state),('active task','Task ID: `validate-libjpeg-so-62-compatibility-provider-consumer-binding`' in active),
('candidate digest','a537840ef9da6135cb3284bc3b3e0d1fb4f624180a416c2a3964b94714eb7fe5' in state),
('brief task','validate-libjpeg-so-62-compatibility-provider-consumer-binding' in brief),
('status marker','LIBJPEG_SO_62_RUNPATH_FREE_CANDIDATE_IDENTITY_ACCEPTED_CONSUMER_VALIDATION_REQUIRED' in status)]:
    if not ok: errors.append(f'missing current marker: {label}')
if errors:
    for e in errors: print('libjpeg-so-62-disposition: FAIL:',e,file=sys.stderr)
    raise SystemExit(1)
print('libjpeg-so-62-disposition: PASS: runpath-free candidate identity accepted; bounded consumer validation required')
PY
echo 'libjpeg-so-62-disposition: all checks passed'
