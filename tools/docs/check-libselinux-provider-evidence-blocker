#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
python3 - "$ROOT" <<'PY_CHECK'
from pathlib import Path
import csv,sys
root=Path(sys.argv[1]); review=root/'experiments/glibc/selected-obsidian-provider-authority/review'; errors=[]
def rows(name):
 with (review/name).open(newline='',encoding='utf-8') as f:return list(csv.DictReader(f,delimiter='\t'))
b=rows('libselinux-provider-evidence-blocker.tsv'); d=rows('libselinux-direct-consumer-necessity-review.tsv')
if len(b)!=1 or b[0].get('review_id')!='LIBSELINUX-BLOCKER-001' or b[0].get('provider_authority_state')!='OPEN_BLOCKED_NO_GLIBC_CANDIDATE':errors.append('historical blocker bytes drifted')
if len(d)!=1 or d[0].get('decision')!='DEPENDENCY_ELIMINATION_OR_RESELECTION':errors.append('superseding decision absent')
if rows('selected-provider-composition-gaps.tsv'):errors.append('historical blocker remains active')
doc=(root/'docs/evidence/libselinux-provider-evidence-blocker.md').read_text(); catalog=(root/'docs/catalog.tsv').read_text()
if 'SUPERSEDED_DEPENDENCY_ELIMINATED_BY_CONSUMER_RESELECTION' not in doc:errors.append('superseded marker absent')
if 'libselinux-provider-evidence-blocker\tevidence\tsuperseded\thistory' not in catalog:errors.append('catalog historical status absent')
if 'different ABI and policy world' not in doc:errors.append('cross-world boundary absent')
if errors:
 for e in errors:print('libselinux-blocker: FAIL:',e,file=sys.stderr)
 raise SystemExit(1)
print('libselinux-blocker: PASS: historical no-candidate/cross-world blocker preserved but superseded by exact consumer reselection')
PY_CHECK
