#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
python3 - "$ROOT" <<'PY'
from pathlib import Path
import csv,sys
root=Path(sys.argv[1]); review=root/'experiments/glibc/selected-obsidian-provider-authority/review'
required=[root/'docs/evidence/missing-glibc-provider-production-boundary.md',review/'missing-glibc-provider-production-boundary.tsv',review/'missing-glibc-provider-production-boundary-metadata.tsv',root/'docs/current/STATE.yaml',root/'docs/current/ACTIVE_TASK.md',root/'docs/current/BRIEF.md',root/'docs/evidence/selected-obsidian-provider-composition-review.md',root/'docs/catalog.tsv',root/'STATUS.md']
errors=[]
for p in required:
    if not p.is_file(): errors.append(f'missing {p.relative_to(root)}')
def rows(p):
    with p.open(newline='',encoding='utf-8') as f:return list(csv.DictReader(f,delimiter='\t'))
if not errors:
    data=rows(review/'missing-glibc-provider-production-boundary.tsv')
    if len(data)!=4: errors.append(f'family rows {len(data)}')
    by={r['family']:r for r in data}
    if set(by)!={'LIBXDAMAGE','AT_SPI2_ATK','GTK3_CORE','LIBSELINUX'}:
        errors.append(f'families {sorted(by)}')
    else:
        x,a,g,s=(by[k] for k in ('LIBXDAMAGE','AT_SPI2_ATK','GTK3_CORE','LIBSELINUX'))
        if x['lane_state']!='BOUNDED_PROVIDER_AUTHORITY_ACCEPTED' or x['recipe_claim_class']!='B' or x['local_artifact_claim_class']!='C' or x['production_order']!='1': errors.append('libXdamage completed lane/class boundary stale')
        if x['reference_version']!='1.1.6' or '52733C1F' not in x['reference_source_boundary']: errors.append('libXdamage exact source boundary missing')
        if a['lane_state']!='BOUNDED_ATOMIC_PROVIDER_AUTHORITY_ACCEPTED_SERVICE_AUTHORITY_EXCLUDED': errors.append('AT-SPI2 bounded provider/service boundary stale')
        if a['atomicity']!='ONE_SOURCE_COHERENT_ARCHIVE_SET_THREE_MEMBERS_COORDINATED_UPDATE' or a['production_order']!='2' or 'E1B1C983' not in a['reference_source_boundary']: errors.append('AT-SPI2 atomic/source/order boundary stale')
        if g['lane_state']!='BOUNDED_ATOMIC_PROVIDER_AUTHORITY_ACCEPTED_PACKAGE_WIDE_EXECUTION_AUTHORITY_EXCLUDED' or g['atomicity']!='ONE_SOURCE_ONE_COHERENT_PACKAGE_SET_GDK_GTK_PAIR' or g['production_order']!='3' or '198AEACE' not in g['reference_source_boundary']: errors.append('GTK candidate authorization/source/order boundary stale')
        if 'EXACT_LIBXDAMAGE_AND_AT_SPI2_ATK_DECISIONS' not in g['prerequisite_boundary']: errors.append('GTK prerequisite authority boundary missing')
        if s['lane_state']!='NO_BUILD_AUTHORIZATION' or s['production_order']!='CONDITIONAL_LAST' or 'DIRECT_CONSUMER' not in s['preferred_lane']: errors.append('libSELinux defer/necessity boundary stale')
        if any(r['eventual_supplier_artifact_class']!='A_OR_B_AFTER_SEPARATE_REVIEW' for r in data): errors.append('supplier publication re-review boundary missing')
    meta={r['key']:r['value'] for r in rows(review/'missing-glibc-provider-production-boundary-metadata.tsv')}
    exp={
      'decision_state':'ACCEPTED_PLANNING_ONLY','reviewed_family_count':'4','reviewed_identity_count':'7',
      'first_production_lane':'NONE_ALL_THREE_AUTHORIZED_PRODUCTION_LANES_COMPLETE',
      'first_task':'GENERATE_AND_REVIEW_NON_MUTATING_SELECTED_TARGET_MANIFEST',
      'immediate_build_authorized':'NO','libselinux_build_authorized':'NO',
      'provider_authority_effect':'LIBXDAMAGE_AT_SPI2_ATK_AND_GTK3_CORE_BOUNDED_PROVIDERS_AND_BOUNDED_APPLICATION_RUNTIME_COMPOSITION_ACCEPTED_LIBSELINUX_ORACLE_EDGE_ELIMINATED_NO_TARGET_DISPLAY_SERVICE_MODULE_SCHEMA_PRINT_POPULATION_OR_ACTIVATION_EFFECT',
      'composition_decision':'ACCEPTED_BOUNDED_COMPLETE_SELECTED_PROVIDER_COMPOSITION','target_manifest_allowed':'NO','activation_allowed':'NO'}
    for k,v in exp.items():
        if meta.get(k)!=v: errors.append(f'metadata {k}: expected {v}, got {meta.get(k)!r}')
    doc=(root/'docs/evidence/missing-glibc-provider-production-boundary.md').read_text(); state=(root/'docs/current/STATE.yaml').read_text(); active=(root/'docs/current/ACTIVE_TASK.md').read_text(); brief=(root/'docs/current/BRIEF.md').read_text(); comp=(root/'docs/evidence/selected-obsidian-provider-composition-review.md').read_text(); catalog=(root/'docs/catalog.tsv').read_text(); status=(root/'STATUS.md').read_text()
    markers=[
      ('decision','ACCEPTED_PLANNING_ONLY' in doc),
      ('class layering','Production recipes and local artifacts remain Class B and Class C claims respectively' in doc),
      ('libXdamage complete','Exact project-produced `libXdamage.so.1.1.0` has bounded' in doc),
      ('AT-SPI2 complete','Exact atomic ATK/ATK-bridge/AT-SPI 2.56.2 family has bounded GTK accessibility library-linkage authority' in doc and 'service metadata and helpers remain inactive' in doc),
      ('libSELinux no build','`libselinux_build_authorized` remains `NO`' in doc),
      ('state route','missing_glibc_provider_production_boundary:' in state),
      ('state GTK lane','gtk3_core_lane: bounded-atomic-provider-authority-accepted-package-wide-execution-authority-excluded' in state),
      ('active task','Task ID: `generate-and-review-non-executing-selected-provider-local-supply-evidence-authorization-issuance-and-coordinate-receipt-production-transaction-implementation-candidate`' in active),
      ('brief decision','accepted target-policy rows:' in brief and '82' in brief and 'intervention:' in brief and 'retained' in brief),
      ('composition next','NON_MUTATING_SELECTED_PROVIDER_LOCAL_SUPPLY_MAP_CONTRACT_ACCEPTANCE_REVIEW' in comp),
      ('catalog','missing-glibc-provider-production-boundary\tevidence\tcurrent\tcanonical' in catalog),
      ('status','atomic GTK 3.24.49 GDK/GTK project candidates accepted as bounded providers' in status and 'libselinux.so.1' in status and '`QUALIFIED_NON_MUTATING_SELECTED_TARGET_MANIFEST`' in status)]
    for label,ok in markers:
        if not ok: errors.append(f'missing marker: {label}')
    for forbidden in ['target/materialization effect:   ALLOWED','libselinux_build_authorized\tYES','activation_allowed\tYES']:
        if forbidden in doc or forbidden in (review/'missing-glibc-provider-production-boundary-metadata.tsv').read_text(): errors.append(f'forbidden widening: {forbidden}')
if errors:
    for e in errors: print('missing-provider-production-boundary: FAIL:',e,file=sys.stderr)
    raise SystemExit(1)
print('missing-provider-production-boundary: PASS: libXdamage, atomic AT-SPI2 and atomic GTK3 providers are bounded; libSELinux remains necessity-review-only with no build authorization')
PY
