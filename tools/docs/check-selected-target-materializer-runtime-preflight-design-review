failed = {k: v for k, v in checks.items() if not v}
if failed:
    print(failed, file=sys.stderr)
    raise SystemExit(1)
print('selected-provider materializer/runtime-preflight design review: PASS: 41-row object plan, 20-state machine, 24 ordered operations, 20 preflight checks, 18 verification checks, 11 recovery contracts, execution authority NO')
