def read_tsv(name: str) -> list[dict[str, str]]:
    with (review / name).open(newline='', encoding='utf-8') as fh:
        return list(csv.DictReader(fh, delimiter='\t'))

with tempfile.TemporaryDirectory() as td:
    subprocess.run(['python3', str(recipe), '--repo-root', str(root), '--output-root', td], check=True)
    generated = Path(td) / 'experiments/glibc/selected-obsidian-provider-authority/review'
    for name in files:
        if (review / name).read_bytes() != (generated / name).read_bytes():
            raise SystemExit(f'generated drift: {name}')

objects = read_tsv('selected-target-materializer-object-plan.tsv')
inputs = read_tsv('selected-target-materializer-input-contract.tsv')
states = read_tsv('selected-target-materializer-state-machine.tsv')
operations = read_tsv('selected-target-materializer-operation-contract.tsv')
preflight = read_tsv('selected-target-runtime-preflight-contract.tsv')
verification = read_tsv('selected-target-materializer-verification-contract.tsv')
recovery = read_tsv('selected-target-materializer-publication-recovery-contract.tsv')
meta = {r['key']: r['value'] for r in read_tsv('selected-target-materializer-design-metadata.tsv')}
design_bytes = (review / 'selected-target-materializer-runtime-preflight-design.json').read_bytes()
design = json.loads(design_bytes)

atomic_counts = Counter(r['atomic_family_id'] for r in objects if r['atomic_family_id'].startswith('ATOMIC-'))
