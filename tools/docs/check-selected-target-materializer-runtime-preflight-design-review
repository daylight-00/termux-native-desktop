texts = '\n'.join((root / p).read_text(encoding='utf-8') for p in [
    'docs/current/ACTIVE_TASK.md', 'docs/current/BRIEF.md', 'docs/current/STATE.yaml',
    'docs/current/PENDING_ARTIFACTS.yaml', 'STATUS.md',
    'docs/evidence/selected-target-materializer-runtime-preflight-design-review.md',
