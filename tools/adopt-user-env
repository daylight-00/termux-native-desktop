#!/data/data/com.termux/files/usr/bin/bash
# Compatibility entry point. Immutable release deployment now owns adoption.
set -euo pipefail
R=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "${1:-}" in
  --dry-run|"") exec "$R/tools/deploy" --dry-run --profile full ;;
  --apply) exec "$R/tools/deploy" --apply --profile full ;;
  *) echo "usage: $0 [--dry-run|--apply]" >&2; exit 2 ;;
esac
