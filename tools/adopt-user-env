#!/data/data/com.termux/files/usr/bin/bash
# One-time, hash-guarded adoption of the pre-refactor shell and uv-base files.
set -euo pipefail

MODE=dry-run
case "${1:-}" in
    --dry-run|"") MODE=dry-run ;;
    --apply) MODE=apply ;;
    *) echo "usage: $0 [--dry-run|--apply]" >&2; exit 2 ;;
esac

R=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
BACKUP_ROOT="$STATE_HOME/termux-native-desktop/adoption/pre-module-layout"

EXPECTED_BASHRC=3c7b8682c4debff14f68fa2a239635aed7d13ec6c11918ddee8f59040245a7cf
EXPECTED_UVRC=f851fe1147541c2f6040c5cce66852ba3d848f70b62ef3e843c8e41339a4641c
EXPECTED_PROJECT=2b89a3855976ca27d81f7bda0c42b7880b52e6b74fae41c83982d115576b4355
EXPECTED_LOCK=79dab5fa4e9246ccfd72c28d569400013858723730f599a15ef6e6f566635a53

log() { printf '%s\n' "$*"; }
run() {
    if [ "$MODE" = dry-run ]; then
        printf '+ '
        printf '%q ' "$@"
        printf '\n'
    else
        "$@"
    fi
}

sha_of() { sha256sum "$1" | awk '{print $1}'; }

verify_regular_hash() {
    local path=$1 expected=$2 actual
    [ -f "$path" ] && [ ! -L "$path" ] || {
        echo "expected regular file: $path" >&2
        exit 1
    }
    actual=$(sha_of "$path")
    [ "$actual" = "$expected" ] || {
        echo "refusing to adopt modified file: $path" >&2
        echo "expected: $expected" >&2
        echo "actual:   $actual" >&2
        exit 1
    }
}

backup_file() {
    local src=$1 rel=$2 dst="$BACKUP_ROOT/$rel"
    if [ -e "$dst" ]; then
        echo "backup already exists: $dst" >&2
        exit 1
    fi
    run mkdir -p "$(dirname "$dst")"
    run cp -p "$src" "$dst"
}

adopt_link() {
    local dst=$1 src=$2 expected=$3 rel=$4
    if [ -L "$dst" ] && [ "$(readlink -f "$dst")" = "$(readlink -f "$src")" ]; then
        log "already adopted: $dst"
        return 0
    fi
    verify_regular_hash "$dst" "$expected"
    backup_file "$dst" "$rel"
    run rm -f "$dst"
    run ln -s "$src" "$dst"
    log "adopted: $dst -> $src"
}

retire_file() {
    local path=$1 expected=$2 rel=$3
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
        log "already retired: $path"
        return 0
    fi
    verify_regular_hash "$path" "$expected"
    backup_file "$path" "$rel"
    run rm -f "$path"
    log "retired after backup: $path"
}

link_config_leaf() {
    local src=$1 dst=$2
    run mkdir -p "$(dirname "$dst")"
    if [ -e "$dst" ] && [ ! -L "$dst" ]; then
        echo "refusing to replace unmanaged config file: $dst" >&2
        exit 1
    fi
    run ln -sfn "$src" "$dst"
    log "linked config: $dst -> $src"
}

log "mode: $MODE"
log "backup root: $BACKUP_ROOT"

adopt_link "$HOME/.bashrc" "$R/modules/shell/overlay/home/.bashrc" "$EXPECTED_BASHRC" home/.bashrc
adopt_link "$HOME/uv-base/pyproject.toml" "$R/modules/uv-base/overlay/home/uv-base/pyproject.toml" "$EXPECTED_PROJECT" home/uv-base/pyproject.toml
adopt_link "$HOME/uv-base/uv.lock" "$R/modules/uv-base/overlay/home/uv-base/uv.lock" "$EXPECTED_LOCK" home/uv-base/uv.lock
retire_file "$HOME/uv-base/.uvrc" "$EXPECTED_UVRC" home/uv-base/.uvrc

link_config_leaf "$R/modules/shell/overlay/home/.config/bash/interactive.sh" "$HOME/.config/bash/interactive.sh"
link_config_leaf "$R/modules/shell/overlay/home/.config/bash/prompt.sh" "$HOME/.config/bash/prompt.sh"
link_config_leaf "$R/modules/shell/overlay/home/.config/bash/aliases.sh" "$HOME/.config/bash/aliases.sh"
link_config_leaf "$R/modules/gl/overlay/home/.config/bash/conf.d/40-gl.sh" "$HOME/.config/bash/conf.d/40-gl.sh"
link_config_leaf "$R/modules/uv-base/overlay/home/.config/bash/conf.d/60-uv-base.sh" "$HOME/.config/bash/conf.d/60-uv-base.sh"
link_config_leaf "$R/modules/shell/overlay/home/.config/bash/conf.d/99-path-policy.sh" "$HOME/.config/bash/conf.d/99-path-policy.sh"

log "adoption complete for mode: $MODE"
log "next step: inspect and run tools/deploy separately"
