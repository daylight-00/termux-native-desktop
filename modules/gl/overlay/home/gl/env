# ~/gl/env — shared baseline for glibc-world apps. `source` from launchers.
# English docs: README.md / docs/. Rules distilled from the build-out sessions.

export DISPLAY=${DISPLAY:-:1}

# glibc-world runtime dir (intentionally different from the session's TMPDIR
# based one — see docs/desktop-session.md §2)
mkdir -p "$PREFIX/tmp/gl-runtime" && chmod 700 "$PREFIX/tmp/gl-runtime"
export XDG_RUNTIME_DIR="$PREFIX/tmp/gl-runtime"
export TMPDIR="$PREFIX/tmp"

# Debian rootfs = data companion for farm libraries (fonts, schemas, locale)
ROOTFS="$PREFIX/var/lib/proot-distro/containers/debian/rootfs"
export XDG_DATA_DIRS="$ROOTFS/usr/share:$ROOTFS/usr/local/share"
export FONTCONFIG_PATH="$ROOTFS/etc/fonts"
export FONTCONFIG_FILE="$ROOTFS/etc/fonts/fonts.conf"
export LOCPATH="$ROOTFS/usr/lib/locale"
export LC_ALL=en_US.UTF-8

export GSETTINGS_BACKEND=memory
export NO_AT_BRIDGE=1
# SUID sandbox check runs BEFORE argv.json is parsed — env var is the only
# clean global fix (README pitfall #5).
export ELECTRON_DISABLE_SANDBOX=1
unset DBUS_SESSION_BUS_ADDRESS DBUS_SYSTEM_BUS_ADDRESS

# TLS: glibc apps cannot find /etc/ssl; point everything at Termux's bundle.
if [ -r "$PREFIX/etc/tls/cert.pem" ]; then
  export SSL_CERT_FILE="$PREFIX/etc/tls/cert.pem"
  export NODE_EXTRA_CA_CERTS="$SSL_CERT_FILE"
  export GIT_SSL_CAINFO="$SSL_CERT_FILE"
  export CURL_CA_BUNDLE="$SSL_CERT_FILE"
  export REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"
fi

# Vulkan policy baseline: sanitize the bionic session's provider selection.
# This is ABI shielding only. It deliberately does NOT choose a glibc Vulkan
# provider. Consumers that require hardware Vulkan must source the explicit
# profile at:
#
#   $HOME/gl/policy/vulkan/freedreno.sh
#
# Keeping sanitation and selection separate prevents provider policy from
# leaking into CPU-mode or provider-neutral glibc processes.
unset VK_ICD_FILENAMES VK_DRIVER_FILES

# NOTE: never set LD_LIBRARY_PATH here (bionic children would load glibc's
# libc.so linker script and die). Library resolution = $ORIGIN rpath +
# $PREFIX/glibc/etc/ld.so.conf (glibc/lib first, then ~/gl/lib farm).
