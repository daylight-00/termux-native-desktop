#!/data/data/com.termux/files/usr/bin/bash
# gl-farm — expose Debian rootfs libraries to the glibc layer (~/gl/lib),
# excluding the Debian libc family (denylist), then refresh the glibc ld cache.
set -eu
ROOTFS=$PREFIX/var/lib/proot-distro/containers/debian/rootfs
FARM=$HOME/gl/lib
DENY='^(libc\.so|libc-|libm\.so|libm-|ld-linux|libpthread|librt\.so|librt-|libdl\.so|libdl-|libresolv|libnss_|libmvec|libanl|libutil\.so|libutil-|libBrokenLocale|libthread_db)'
rm -rf "$FARM"; mkdir -p "$FARM"
n=0
for d in "$ROOTFS/usr/lib/aarch64-linux-gnu" "$ROOTFS/usr/lib" "$ROOTFS/lib/aarch64-linux-gnu"; do
  [ -d "$d" ] || continue
  for f in "$d"/*.so*; do
    [ -e "$f" ] || continue
    b=$(basename "$f")
    echo "$b" | grep -qE "$DENY" && continue
    [ -e "$FARM/$b" ] || { ln -s "$f" "$FARM/$b"; n=$((n+1)); }
  done
done
echo "farm: $n links"
# contamination check (must print OK)
ls "$FARM" | grep -qE 'libc\.so|ld-linux|libpthread' \
  && echo "FAIL: libc contamination in farm!" && exit 1 || echo "denylist: OK"
# farm refresh = cache refresh, always together
env LD_PRELOAD= "$PREFIX/glibc/bin/ldconfig"
