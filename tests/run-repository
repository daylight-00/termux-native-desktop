      tests/repository/libxdamage-bounded-provider-authority-smoke.sh
      tests/repository/gdkpixbuf-reference-dependency-provider-authority-smoke.sh
      tests/repository/gdkpixbuf-exact-util-linux-provider-authority-smoke.sh
      tests/repository/libxcursor-bounded-provider-authority-smoke.sh
      tests/repository/libthai-libdatrie-iconv-bounded-provider-authority-smoke.sh
      tests/repository/libcloudproviders-bounded-provider-authority-smoke.sh
      tests/repository/fribidi-bounded-provider-authority-smoke.sh
      tests/repository/freetype-bounded-provider-authority-smoke.sh
