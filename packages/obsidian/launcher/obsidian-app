#!/data/data/com.termux/files/usr/bin/bash
# Obsidian GUI — extracted AppImage on the native glibc layer
set -u -o pipefail

source "$HOME/gl/env"

APP="$HOME/gl/apps/obsidian"

export APPDIR="$APP"
export PATH="$HOME/gl/shims:$APP:$APP/usr/sbin:$PATH"
export XDG_DATA_DIRS="$APP/usr/share:${XDG_DATA_DIRS:-}"

if [ -d "$APP/usr/share/glib-2.0/schemas" ]; then
    export GSETTINGS_SCHEMA_DIR="$APP/usr/share/glib-2.0/schemas"
fi

GPU_FLAGS=(--disable-gpu)
FREEDRENO_PROFILE="$HOME/gl/policy/vulkan/freedreno.sh"

if [ "${GL_GPU:-1}" = "1" ] && \
   [ -r "$FREEDRENO_PROFILE" ] && \
   source "$FREEDRENO_PROFILE"; then
    GPU_FLAGS=(
        --disable-gpu-sandbox
        --ignore-gpu-blocklist
        --enable-features=Vulkan
        --use-gl=angle
        --use-angle=vulkan
        --disable-gpu-vsync
    )
fi

exec env LD_PRELOAD= \
    "$APP/obsidian" \
    --disable-dev-shm-usage \
    --ozone-platform=x11 \
    "${GPU_FLAGS[@]}" \
    "$@"
